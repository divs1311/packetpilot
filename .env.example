# Copy to .env (never commit real keys). Everything is optional.
DATABASE_URL=sqlite:///./data/packetpilot.db      # or postgresql://user:pass@host:5432/packetpilot
REDIS_URL=                                         # e.g. redis://localhost:6379/0 to use RQ workers
PACKETPILOT_EXTRACTOR=auto                         # rules | llm | hybrid | auto (hybrid if a key is set)
PACKETPILOT_LLM_PROVIDER=auto                      # openai | gemini | auto
OPENAI_API_KEY=
PACKETPILOT_OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
PACKETPILOT_GEMINI_MODEL=gemini-2.5-flash
PACKETPILOT_API_KEY=                               # require X-API-Key on /api
PACKETPILOT_STORAGE=db                             # db | fs
PACKETPILOT_AUTO_VERIFY_THRESHOLD=0.90
PACKETPILOT_LOW_CONFIDENCE_THRESHOLD=0.75
PACKETPILOT_MONEY_TOLERANCE=0.02
PACKETPILOT_LOSS_RUN_MAX_AGE_DAYS=90
PACKETPILOT_SLA_HOURS=24
PACKETPILOT_API_URL=                               # set for the Streamlit UI to use the API instead of embedded mode
